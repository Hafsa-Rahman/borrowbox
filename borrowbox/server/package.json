{
  "name": "borrowbox-server",
  "version": "1.0.0",
  "description": "BorrowBox API - Community Tool & Equipment Lending Platform",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:schema": "psql -U $PGUSER -d $PGDATABASE -f src/db/schema.sql",
    "db:seed": "psql -U $PGUSER -d $PGDATABASE -f src/db/seed.sql"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
